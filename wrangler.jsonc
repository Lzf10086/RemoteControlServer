{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "remote-control-server",

  "main": "src/index.js",

  "compatibility_date": "2026-09-09",

  "durable_objects": {
    "bindings": [
      {
        "name": "REMOTE_CONTROL",
        "class_name": "RemoteControlServer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RemoteControlServer"
      ]
    }
  ]
}
